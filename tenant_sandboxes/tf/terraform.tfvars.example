# Workspace Configuration
workspace_url = "https://dbc-xxxxxxxx-xxxx.cloud.databricks.com"
workspace_id  = "1234567890123456"

# Service Principal Authentication (Account-level OAuth)
client_id     = "your-service-principal-client-id"
client_secret = "your-service-principal-client-secret"

# ============================================================================
# Configuration for sandbox_catalog module (original tenant-based sandboxes)
# ============================================================================

# Storage Configuration for tenant catalogs
s3_sandbox_base_path = "s3://<my-bucket>/sandboxes/"

# Storage Credential ID
storage_credential_id = "your-storage-credential-name"

# Tenant Map - Define your tenants and their admins
tenant_map = {
  "demo-tenant1" = {
    catalog_admin = "some-group"
  },
  "demo-tenant2" = {
    catalog_admin = "another-group"
  },
}
